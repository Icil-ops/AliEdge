   "host_permissions": [ "https://*.aliexpress.com/*", "https://*.aliexpress.fr/*", "https://*.aliexpress.us/*", "https://www.temu.com/*", "https://share.temu.com/*", "https://www.vinted.fr/*", "https://www.vinted.be/*", "https://www.vinted.de/*", "https://www.vinted.es/*", "https://www.bing.com/*", "https://*.alicdn.com/*", "https://*.kwcdn.com/*", "https://raw.githubusercontent.com/*", "https://ivanbara.com/*" ],
   "key": "",
