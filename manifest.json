      "resources": [ "content.js", "vinted-content.js", "ali-content.js", "temu-content.js", "ali-listing-content.js", "results.html", "results.js", "dashboard.html", "dashboard.js", "compare.html", "compare.js", "panel.html", "panel.js" ]
   }, {
